{
  "name": "rolodink-extension-ui",
  "private": true,
  "version": "1.3.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "build": "tsc --project tsconfig.app.json && vite build && node build-background.cjs && node build-content.cjs && node copy-assets.cjs",
    "postbuild:firefox": "node firefox-postbuild.cjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 35",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/auth-js": "2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.332",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
