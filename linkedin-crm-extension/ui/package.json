{
  "name": "rolodink-extension-ui",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "build": "tsc --project tsconfig.app.json && vite build && node build-background.cjs && node build-content.cjs && node copy-assets.cjs",
    "postbuild:firefox": "node firefox-postbuild.cjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 35",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^25.0.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^5.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
